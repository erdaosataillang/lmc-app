{
  "name": "urakata-app-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test app-api.test.js chat-auth.test.js lottery.test.js schedule-api.test.js",
    "test:rules": "firebase emulators:exec --only firestore,storage '/usr/local/bin/node --test --test-concurrency=1 firestore.rules.test.js storage.rules.test.js'",
    "deploy": "firebase deploy --only firestore:rules,storage,functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "acorn": "^8.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
