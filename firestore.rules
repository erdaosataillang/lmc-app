rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedLineUser() {
      return request.auth != null && request.auth.token.line == true;
    }

    function isAdmin() {
      return isVerifiedLineUser() && request.auth.token.admin == true;
    }

    function isBandMember(bandId) {
      return isVerifiedLineUser() &&
        get(/databases/$(database)/documents/bands/$(bandId)).data.memberIds is list &&
        get(/databases/$(database)/documents/bands/$(bandId)).data.memberIds.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      allow read: if isVerifiedLineUser();
      allow create: if isAdmin() || (isVerifiedLineUser() && userId == request.auth.uid);
      allow update: if isAdmin() || (isVerifiedLineUser() && userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /bands/{bandId} {
      allow read: if isVerifiedLineUser();
      allow create: if isAdmin() ||
        (isVerifiedLineUser() && request.resource.data.memberIds is list &&
          request.resource.data.memberIds.hasAny([request.auth.uid]));
      allow update: if isAdmin() || isBandMember(bandId) ||
        (isVerifiedLineUser() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])) ||
        (isVerifiedLineUser() && resource.data.memberIds is list &&
          request.resource.data.memberIds is list &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds", "memberNames"]) &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.resource.data.memberIds.hasAny([request.auth.uid]) &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1);
      allow delete: if isAdmin() || isBandMember(bandId);
    }

    match /bookings/{bookingId} {
      allow read: if isVerifiedLineUser();
      allow create: if isAdmin() ||
        (isVerifiedLineUser() && request.resource.data.creatorId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isVerifiedLineUser() && resource.data.creatorId == request.auth.uid) ||
        (resource.data.bandId is string && isBandMember(resource.data.bandId));
    }

    match /cuesheets/{cueSheetId} {
      allow read: if isVerifiedLineUser();
      allow create: if isAdmin() ||
        (request.resource.data.bandId is string && isBandMember(request.resource.data.bandId));
      allow update, delete: if isAdmin() ||
        (resource.data.bandId is string && isBandMember(resource.data.bandId));
    }

    match /events/{eventId} {
      allow read: if isVerifiedLineUser();
      allow write: if isAdmin();
    }

    match /system/{documentId} {
      allow read: if isVerifiedLineUser();
      allow write: if isAdmin();
    }

    match /lotteryRuns/{runId} {
      allow read: if isVerifiedLineUser();
      allow write: if isAdmin();
    }

    match /mail_queue/{messageId} {
      allow create: if isVerifiedLineUser() && request.resource.data.userId == request.auth.uid;
    }
  }
}
